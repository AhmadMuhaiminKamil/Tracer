# Copy this file to .env.local and fill in YOUR OWN keys.
# Nothing here is provided by the project — bring your own accounts.

# LLM gateway for the chat agent (OpenAI-compatible /chat/completions).
LLM_BASE_URL=https://your-gateway.example/v1
LLM_MODEL=your-model-name
LLM_API_KEY=

# Optional: where the snapshot file lives. Defaults to python/data/sectors_snapshot.json
# INSIDERIQ_SNAPSHOT=/absolute/path/to/sectors_snapshot.json
